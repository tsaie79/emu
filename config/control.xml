<?xml version="1.0" encoding="UTF-8"?>
<control>
    <name>SimulationControl</name>
    <class>org.jlab.coda.emu.support.control.CodaRCServer</class>
    
    <platform>
        <name>platform</name>
        <configFile>platform.xml</configFile>
    </platform>
    
    <components>
        <component>
            <name>SimulationROC</name>
            <host>SimulationHost</host>
            <type>ROC</type>
            <option>
                <name>configFile</name>
                <value>simulation_roc.xml</value>
            </option>
        </component>
    </components>
    
    <options>
        <option>
            <name>expid</name>
            <value>simulation</value>
        </option>
        <option>
            <name>session</name>
            <value>sim1</value>
        </option>
    </options>
</control> 