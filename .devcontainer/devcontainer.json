{
    "name": "EMU Development",
    "dockerFile": "Dockerfile",
    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.java",
                "vscjava.vscode-java-debug",
                "vscjava.vscode-java-test",
                "vscjava.vscode-maven",
                "vscjava.vscode-java-dependency"
            ]
        }
    },
    "forwardPorts": [],
    "postCreateCommand": "bash .devcontainer/install-coda.sh && ant prepare",
    "remoteUser": "vscode",
    "mounts": [
        "source=/scratch/jeng-yuantsai,target=/scratch,type=bind,consistency=cached",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached"
    ],
    "runArgs": [
        "--env=DISPLAY=${localEnv:DISPLAY}"
    ],
    "containerEnv": {
        "DISPLAY": ":0"
    }
} 