<?xml version="1.0"?>
<project name="SimpleEmuExample" default="run" basedir=".">
    <property name="src.dir" value="."/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="jar.dir" value="${build.dir}/jar"/>
    
    <!-- EMU library path - relative to the main project directory -->
    <property name="emu.lib" value="../build/lib/emu-3.3.jar"/>
    <property name="cmsg.lib" value="../java/jars/cMsg-6.0.jar"/>
    <property name="et.lib" value="../java/jars/et-16.4.jar"/>
    <property name="jevio.lib" value="../java/jars/jevio-6.0.jar"/>
    <property name="disruptor.lib" value="../java/jars/disruptor-3.4.3.jar"/>
    <property name="swing.layout.lib" value="../java/jars/swing-layout.jar"/>
    
    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>
    
    <target name="compile">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false">
            <classpath>
                <pathelement location="${emu.lib}"/>
                <pathelement location="${cmsg.lib}"/>
                <pathelement location="${et.lib}"/>
                <pathelement location="${jevio.lib}"/>
                <pathelement location="${disruptor.lib}"/>
                <pathelement location="${swing.layout.lib}"/>
            </classpath>
        </javac>
    </target>
    
    <target name="jar" depends="compile">
        <mkdir dir="${jar.dir}"/>
        <jar destfile="${jar.dir}/SimpleEmuExample.jar" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="examples.SimpleEmuExample"/>
                <attribute name="Class-Path" value="../build/lib/emu-3.3.jar ../java/jars/cMsg-6.0.jar ../java/jars/et-16.4.jar ../java/jars/jevio-6.0.jar ../java/jars/disruptor-3.4.3.jar ../java/jars/swing-layout.jar"/>
            </manifest>
        </jar>
    </target>
    
    <target name="run" depends="jar">
        <java classname="examples.SimpleEmuExample" fork="true">
            <classpath>
                <pathelement location="${jar.dir}/SimpleEmuExample.jar"/>
                <pathelement location="${emu.lib}"/>
                <pathelement location="${cmsg.lib}"/>
                <pathelement location="${et.lib}"/>
                <pathelement location="${jevio.lib}"/>
                <pathelement location="${disruptor.lib}"/>
                <pathelement location="${swing.layout.lib}"/>
            </classpath>
        </java>
    </target>
</project> 